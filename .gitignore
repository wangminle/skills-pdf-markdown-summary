### Simplified Python project ignores

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Packaging
build/
dist/
*.egg-info/
*.egg
wheels/

# Logs and caches
.cache/
.pytest_cache/
.ruff_cache/
pip-log.txt
pip-delete-this-directory.txt

# Coverage / test
.coverage
.coverage.*
htmlcov/
coverage.xml

# mypy / type checkers
.mypy_cache/
.pytype/
.pyre/

# Jupyter
.ipynb_checkpoints/

# Editors / tools
.cursorignore
.cursorindexingignore
.pypirc
.claude/
node_modules/
**/.DS_Store

# Windows 系统缓存
Thumbs.db
ehthumbs.db
desktop.ini

# 编辑器临时/备份文件
*.swp
*.swo
*~

# 环境变量与密钥（避免泄露）
.env
.env.*

# Project specific
docs/_build/
__pypackages__/
cython_debug/

# 测试运行产物（不上传 GitHub）
# 注意：不要忽略整个 tests/ —— 下列内容应保留可提交：
#   tests/scripts/          pytest
#   tests/eval/             版本化评测器
#   tests/basic-benchmark/  回测 PDF 与 golden_index.json
tests/results/
# 人工标注 GT（bootstrap，待人工复核替换）
tests/annotations/
# 冻结 holdout 集（PDF + 标注 + 评估结果）
tests/holdout/

# 实验目录（含大量 PNG/debug/Layout 产物，本地保留，不上传 GitHub）
docs/3-experiments/
